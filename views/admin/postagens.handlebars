<h2>Lista de postagens:</h2>
<hr>
<a href="/admin/postagens/add"><button class="btn btn-success">Nova postagem</button></a>

{{#each postagens}}
<div class="card mt-4">
    <div class="card-body">
        <h4>{{titulo}}</h4>
        <p> Descrição:{{descricao}}</p>
        <small>Criado em: {{data}}</small><br>
        <small>Categoria: {{categoria.nome}}</small><br><br>
        {{#if ../user}}
            {{#or (eq ../user._id this.autor) (eq ../user.eAdmin 1)}}
                <a href="/admin/postagens/edit/{{_id}}"><button class="btn btn-primary">Editar postagem</button></a>
                <a href="/admin/postagens/deletar/{{_id}}"><button class="btn btn-danger">Excluir postagem</button></a>
            {{/or}}
        {{/if}}
    </div>
</div>
{{else}}
    <h4>Nenhuma postagem registrada</h4>
{{/each}}